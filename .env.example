# Environment variables for local development and deployment.
# Copy to .env.local and fill in values. Never commit .env.local.

# ── Google Analytics 4 ───────────────────────────────────────────────────────
# Public measurement ID (safe in the browser). Defaults to G-SXMYZ684LN in code
# when unset. Set to empty to disable GA locally:
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-SXMYZ684LN

# ── Voice Agent demo (ElevenLabs Conversational AI) ──────────────────────────
# Required for the live browser demo on /voice-agent.
# Create an agent in the ElevenLabs dashboard, then paste:
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Without both values, the page and API show "Demo currently unavailable"
# and never simulate a successful connection.

# ── Contact / project enquiry (Web3Forms) ────────────────────────────────────
# Required for ContactInquiryForm to deliver enquiries.
# Create an access key at https://web3forms.com — Web3Forms documents this key
# as safe to use in the browser (client-side submit; server-side needs a paid plan).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional legacy Resend path for POST /api/contact mock verification only.
# The live site form uses Web3Forms, not Resend.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Buildaze <hello@your-verified-domain.com>
# CONTACT_TO_EMAIL=team@buildaze.com
# CONTACT_EMAIL_TRANSPORT=mock

# Without NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY, forms show an honest unconfigured
# error. Mailto drafts are a human fallback only — never counted as a received enquiry.
# Do not send test inquiries to production inboxes without authorization.
# Run: npm run verify:contact
